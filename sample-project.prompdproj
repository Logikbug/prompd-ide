# Prompd Project Configuration
# This file defines the structure and configuration for a Prompd project

# Project metadata
name: "My Prompd Project"
version: "1.0.0"
description: "A sample Prompd project demonstrating workflows, dependencies, and configuration"
author: "Project Author"

# Exposed workflows that are available to the IDE
workflows:
  - name: "data-analysis"
    file: "workflows/analyze-data.prompdflow"
    description: "Analyze dataset and generate insights"
    inputs:
      - name: "dataset"
        type: "file"
        required: true
      - name: "analysis_type"
        type: "string"
        default: "basic"
    outputs:
      - name: "report"
        type: "markdown"
      - name: "charts"
        type: "images"
  
  - name: "code-review"
    file: "workflows/review-code.prompdflow"
    description: "Automated code review with AI assistance"
    inputs:
      - name: "source_files"
        type: "files"
        pattern: "**/*.{js,ts,py}"
      - name: "review_level"
        type: "enum"
        values: ["basic", "detailed", "security"]
        default: "detailed"
    outputs:
      - name: "review_report"
        type: "markdown"
      - name: "suggestions"
        type: "json"

# Dependencies required for this project
dependencies:
  # External tools and services
  tools:
    - name: "openai"
      version: ">=4.0.0"
      required: true
    - name: "anthropic"
      version: ">=0.3.0"
      optional: true
  
  # Python packages (if using Python-based prompts)
  python:
    - "pandas>=1.3.0"
    - "matplotlib>=3.5.0"
    - "requests>=2.28.0"
  
  # Node.js packages (if using JS/TS-based prompts)
  npm:
    - "@types/node": ">=16.0.0"
    - "axios": ">=1.0.0"

# File exclusion patterns
exclusions:
  # Directories to exclude from project operations
  directories:
    - "node_modules"
    - ".git"
    - "__pycache__"
    - ".vscode"
    - "dist"
    - "build"
    - ".tmp"
  
  # File patterns to exclude
  patterns:
    - "*.log"
    - "*.tmp"
    - "*.cache"
    - ".env*"
    - "*.secret"
    - "*.key"
  
  # Specific files to exclude
  files:
    - ".DS_Store"
    - "Thumbs.db"

# Project settings and configuration
settings:
  # Default AI provider for this project
  default_provider: "openai"
  default_model: "gpt-4"
  
  # Project-specific prompt templates
  templates:
    base_prompt: "prompts/templates/base.prompd"
    system_prompt: "prompts/templates/system.prompd"
  
  # Output configurations
  output:
    directory: "output"
    format: "markdown"
    include_metadata: true
  
  # Execution settings
  execution:
    parallel_workflows: 3
    timeout_minutes: 30
    retry_attempts: 2
    
  # Security settings
  security:
    allow_file_access: true
    allow_network_access: true
    sandbox_mode: false
    
# Environment variables and secrets configuration
environment:
  # Variables available to all workflows
  variables:
    PROJECT_NAME: "${name}"
    PROJECT_VERSION: "${version}"
    OUTPUT_DIR: "${settings.output.directory}"
  
  # Secret references (actual values stored securely)
  secrets:
    - "OPENAI_API_KEY"
    - "ANTHROPIC_API_KEY"
    - "DATABASE_URL"

# Custom commands available in this project
commands:
  - name: "setup"
    description: "Initialize project environment"
    script: "scripts/setup.sh"
  
  - name: "validate"
    description: "Validate all prompts and workflows"
    script: "scripts/validate.sh"
  
  - name: "deploy"
    description: "Deploy workflows to production"
    script: "scripts/deploy.sh"
    requires: ["validate"]

# Integration settings
integrations:
  # Version control
  git:
    hooks:
      pre_commit: "npm run validate"
      pre_push: "npm run test"
  
  # CI/CD integration
  ci:
    provider: "github_actions"
    config_file: ".github/workflows/prompd.yml"
  
  # External services
  services:
    - name: "slack"
      webhook_url: "${secrets.SLACK_WEBHOOK}"
      notify_on: ["workflow_complete", "error"]