{
  "name": "prompdx",
  "displayName": "Prompd",
  "description": "Language support for Prompd (.prompd) files - structured prompt definitions for LLMs",
  "version": "0.2.0",
  "publisher": "logikbug",
  "icon": "icons/prompd-icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Other"
  ],
  "keywords": [
    "prompd",
    "prompt",
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gpt",
    "claude"
  ],
  "activationEvents": [
    "onLanguage:prompd",
    "onCommand:prompdx.debugPrompt"
  ],
  "main": "./out/extensionMinimal.js",
  "contributes": {
    "languages": [
      {
        "id": "prompd",
        "aliases": ["Prompd", "prompd", "PMD"],
        "extensions": [".prompd"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/prompd-icon.svg",
          "dark": "./icons/prompd-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "prompd",
        "scopeName": "source.prompd",
        "path": "./syntaxes/prompdx.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "prompdx.execute",
        "title": "Execute Prompd File",
        "category": "Prompd IDE",
        "icon": "$(play)"
      },
      {
        "command": "prompdx.validate",
        "title": "Validate Prompd File",
        "category": "Prompd IDE",
        "icon": "$(check)"
      },
      {
        "command": "prompdx.bumpVersion",
        "title": "Bump Version",
        "category": "Prompd IDE",
        "icon": "$(tag)"
      },
      {
        "command": "prompdx.preview",
        "title": "Preview Rendered Prompt",
        "category": "Prompd IDE",
        "icon": "$(eye)"
      },
      {
        "command": "prompdx.gitAdd",
        "title": "Git Add",
        "category": "Prompd IDE",
        "icon": "$(add)"
      },
      {
        "command": "prompdx.gitCommit",
        "title": "Git Commit",
        "category": "Prompd IDE",
        "icon": "$(check-all)"
      },
      {
        "command": "prompdx.gitCheckout",
        "title": "Checkout Version",
        "category": "Prompd IDE",
        "icon": "$(git-branch)"
      },
      {
        "command": "prompdx.versionHistory",
        "title": "Show Version History",
        "category": "Prompd IDE",
        "icon": "$(history)"
      },
      {
        "command": "prompdx.executeVersion",
        "title": "Execute Specific Version",
        "category": "Prompd IDE",
        "icon": "$(run)"
      },
      {
        "command": "prompdx.executeWithResponseCapture",
        "title": "Execute with Response Capture",
        "category": "Prompd IDE",
        "icon": "$(play-circle)"
      },
      {
        "command": "prompdx.showParameterTable",
        "title": "Show Parameter Table",
        "category": "Prompd IDE",
        "icon": "$(table)"
      },
      {
        "command": "prompdx.debugPrompt",
        "title": "Debug & Analyze Prompt",
        "category": "Prompd IDE",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.execute",
          "group": "navigation@1"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.validate",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.execute",
          "group": "prompd@1"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.validate",
          "group": "prompd@2"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.executeVersion",
          "group": "prompd@3"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.versionHistory",
          "group": "prompd@4"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.gitAdd",
          "group": "prompd_git@1"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.gitCommit",
          "group": "prompd_git@2"
        },
        {
          "when": "resourceExtname == .prompd",
          "command": "prompdx.debugPrompt",
          "group": "prompd_debug@1"
        }
      ]
    },
    "views": {
      "prompd": [
        {
          "id": "prompdxParametersNative",
          "name": "Parameters & Execution",
          "when": "resourceExtname == .prompd || prompd:hasPrompdFiles"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prompd",
          "title": "Prompd",
          "icon": "./icons/prompd-icon.svg"
        }
      ]
    },
    "snippets": [
      {
        "language": "prompd",
        "path": "./snippets/prompd.json"
      }
    ],
    "configuration": {
      "title": "Prompd",
      "properties": {
        "prompd.defaultProvider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "anthropic", "ollama"],
          "description": "Default LLM provider for executing prompts"
        },
        "prompd.defaultModel": {
          "type": "string",
          "default": "gpt-4",
          "description": "Default model for executing prompts"
        },
        "prompd.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate .prompd files on save"
        },
        "prompd.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline execution buttons above prompts"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "yaml": "^2.3.0"
  }
}